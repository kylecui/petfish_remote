{
  "name": "petfish-remote",
  "version": "0.1.0",
  "description": "Chat-based control plane for safely operating opencode agents across project workspaces",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "start:connector": "node dist/connector/main.js",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "opencode",
    "telegram",
    "remote-control",
    "ai-agent",
    "petfish"
  ],
  "author": "",
  "license": "SEE LICENSE IN LICENSE AND LICENSE-SERVER",
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.62.1",
    "@opencode-ai/sdk": "^1.14.46",
    "@slack/bolt": "^4.7.2",
    "@wecom/aibot-node-sdk": "^1.0.6",
    "better-sqlite3": "^11.8.0",
    "grammy": "^1.35.0",
    "nanoid": "^5.1.0",
    "ws": "^8.20.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.20.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
